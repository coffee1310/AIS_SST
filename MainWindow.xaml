<Window x:Class="Diplom_Stud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom_Stud"
        mc:Ignorable="d"
        Title="Студенческий совет КИПФИН" Height="1024" Width="1538"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0D0914">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A7886"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A283C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="GroupName" Value="MainMenu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#615292"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MainMenu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,25,15,20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#615292"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#08060D">
            <TextBlock Text="Студенческий совет КИПФИН" Foreground="#7A7886" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click"/>
                <Button Content="☐" Style="{StaticResource WindowButtonStyle}" FontSize="14" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">

            <Grid.Background>
                <SolidColorBrush Color="#030106"/>
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.ColumnSpan="2" 
                     Width="1200" Height="1200" 
                     HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="-400,-400,0,0" 
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#88453281" Offset="0"/>
                        <GradientStop Color="#00453281" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Grid.ColumnSpan="2" 
                     Width="1000" Height="1000" 
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                     Margin="0,0,-300,-250" 
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#66453281" Offset="0"/>
                        <GradientStop Color="#00453281" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Border x:Name="LeftMenu" Width="220" Grid.Column="0" Margin="0" CornerRadius="20,20,0,0" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3D3D3D" Offset="0.0"/>
                        <GradientStop Color="#141414" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RadioButton x:Name="NavProfile" Grid.Row="0" Style="{StaticResource ProfileRadioButtonStyle}" Margin="10,20,10,20" Click="MenuProfile_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="60" Height="60" Stroke="White" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Resources/prof.png" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="Иванов Иван" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="Digital Pixel"/>
                            <TextBlock Text="123456@edu.fa.ru" Foreground="#D1CDEF" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <StackPanel Grid.Row="1" Margin="0,0,0,0">
                        <RadioButton x:Name="NavHome" Content="Главная" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10" Click="MenuHome_Click"/>
                        <RadioButton x:Name="NavEvents" Content="Мероприятия" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                        <RadioButton x:Name="NavTasks" Content="Задачи" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                        <RadioButton x:Name="NavProjects" Content="Проекты" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                        <RadioButton x:Name="NavRating" Content="Рейтинг" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                        <RadioButton x:Name="NavNotifications" Content="Уведомления" Style="{StaticResource MenuRadioButtonStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource OutlineButtonStyle}" Margin="20,20,20,30" Padding="10" Click="Logout_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10,2 L2,2 L2,14 L10,14 M6,8 L14,8 M11,5 L14,8 L11,11" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Выход" FontFamily="Digital Pixel" FontSize="8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
        </Grid>
    </Grid>
</Window>