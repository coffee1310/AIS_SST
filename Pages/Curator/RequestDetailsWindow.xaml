<Window x:Class="Diplom_Stud.Pages.Curator.RequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request Details" Height="850" Width="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource CardBorderStyle}" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.6" ShadowDepth="0" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="ПОЛНАЯ ИНФОРМАЦИЯ" Foreground="White" FontFamily="Digital Pixel" FontSize="22" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#7A7886" BorderThickness="0" Cursor="Hand" Click="CloseDetails_Click" FontSize="18"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" MaxHeight="700">
                <StackPanel>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="120" Height="120" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Border HorizontalAlignment="Left" Padding="12,5" CornerRadius="6" Background="#1A1A24" BorderBrush="#2A283C" BorderThickness="1">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" FontFamily="Montserrat" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Foreground="#02B3BA" FontFamily="Digital Pixel" FontSize="14" Margin="0,0,0,15"/>
                    <UniformGrid Columns="3" Margin="0,0,0,25">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Пол" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding Gender}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Дата рождения" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding DateOfBirth}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Возраст" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding Age}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="КОНТАКТЫ" Foreground="#02B3BA" FontFamily="Digital Pixel" FontSize="14" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,25">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Телефон" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding Phone}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ВКонтакте" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding VkLink}" Foreground="White" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Корпоративная почта" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding Email}" Foreground="White" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Дополнительная почта" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding AdditionalEmailDisplay}" Foreground="White" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="ОБУЧЕНИЕ" Foreground="#02B3BA" FontFamily="Digital Pixel" FontSize="14" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,25">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Студенческий билет" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding StudentId}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Курс и группа" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="{Binding GroupInfo}" Foreground="White" FontSize="14" FontFamily="Montserrat"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Специальность" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding SpecialityName}" Foreground="White" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="СОЦИАЛЬНЫЙ БЛОК" Foreground="#02B3BA" FontFamily="Digital Pixel" FontSize="14" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Социальные статусы" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding SocialStatusesDisplay}" Foreground="#D1CDEF" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding RejectionVisibility}">
                            <TextBlock Text="Причина отклонения" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                            <TextBlock Text="{Binding RejectionReason}" Foreground="#E81123" FontSize="14" FontFamily="Montserrat" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding CreatedAtDisplay}" Foreground="#444444" FontSize="11" FontFamily="Montserrat Thin" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>