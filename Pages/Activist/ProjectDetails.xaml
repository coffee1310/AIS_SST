<Page x:Class="Diplom_Stud.Pages.Activist.ProjectDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Project Details"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <TextBlock Text="Проект" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,60"/>

                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="380" Height="220" CornerRadius="12" Margin="0,0,40,0" ClipToBounds="True" VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/project1.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="Школа Актива" FontSize="24" FontFamily="Digital Pixel" Foreground="White" Margin="0,0,0,15"/>
                        <TextBlock Text="Курс для начинающих активистов. Научим основам проектной деятельности, тайм-менеджменту и работе в команде. Участники смогут разработать и реализовать свой первый проект под руководством опытных наставников." 
                                   Foreground="#7A7886" FontSize="13" FontFamily="Montserrat Thin" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="M8,8 C10.21,8 12,6.21 12,4 C12,1.79 10.21,0 8,0 C5.79,0 4,1.79 4,4 C4,6.21 5.79,8 8,8 Z M8,10 C5.33,10 0,11.34 0,14 L0,16 L16,16 L16,14 C16,11.34 10.67,10 8,10 Z" 
                              Fill="Transparent" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="14" Height="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Организатор" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin" Margin="0,0,0,3"/>
                            <TextBlock Text="Широкова Арина" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Path Data="M2,2 L14,2 L14,11 L2,11 Z M6,14 L10,14 M8,11 L8,14" 
                              Fill="Transparent" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Как проводится" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin" Margin="0,0,0,3"/>
                            <TextBlock Text="Онлайн-лекции и очные воркшопы" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" 
                              Fill="Transparent" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Где проводится" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin" Margin="0,0,0,3"/>
                            <TextBlock Text="Кронштадтский бульвар, 37Б, Актовый зал" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button Content="Присоединиться" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="60,15" FontSize="14" Cursor="Hand"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>