<Page x:Class="Diplom_Stud.Pages.Activist.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d"
      Title="Profile Page" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="993" Width="1111">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#12101C"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6B5EAE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,-131">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#0D0914" Offset="0"/>
                <GradientStop Color="#1A1525" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0C0A15" BorderBrush="#2A283C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF0C0A15" CornerRadius="0,0,20,20" Padding="15,25,15,20" Margin="10,0,10,20">
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="60" Height="60" Stroke="White" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Resources/prof.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Иванов Иван" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="Digital Pixel"/>
                        <TextBlock Text="123456@edu.fa.ru" Foreground="#D1CDEF" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Главная" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    <TextBlock Text="Мероприятия" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    <TextBlock Text="Задачи" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    <TextBlock Text="Проекты" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    <TextBlock Text="Рейтинг" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                    <TextBlock Text="Уведомления" Style="{StaticResource MenuLinkStyle}" FontFamily="Digital Pixel" FontSize="10"/>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource OutlineButtonStyle}" Margin="20,20,20,30" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10,2 L2,2 L2,14 L10,14 M6,8 L14,8 M11,5 L14,8 L11,11" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Выход" FontFamily="Digital Pixel" FontSize="8"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,30" MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="90" Height="90" Margin="0,0,20,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Resources/prof.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Иванов Иван Иванович" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" FontFamily="Digital Pixel" FontSize="11"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Активист студсовета" Foreground="#7A7886" FontSize="13" Margin="0,0,30,0"/>
                            <TextBlock Text="Группа: 4ИСИП-221" Foreground="#7A7886" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"/>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="15,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Всего мероприятий:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <TextBlock Text="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="10,0,10,0" Padding="15,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Баллы рейтинга:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <TextBlock Text="125" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0" Padding="15,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Место в рейтинге:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Редактировать" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,15,0" FontFamily="Digital Pixel" FontSize="6"/>
                    </StackPanel>
                    <Button Content="История баллов" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="Button_Click" FontFamily="Digital Pixel" FontSize="6"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Общая информация" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="10"/>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Дата рождения" Foreground="#7A7886"/>
                                <TextBlock Text="15 августа 2003" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Номер студенческого билета" Foreground="#7A7886"/>
                                <TextBlock Text="123456" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            

                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Социальный статус" Foreground="#7A7886"/>
                                <TextBlock Text="Отсутствует" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Пол" Foreground="#7A7886"/>
                                <TextBlock Text="Мужской" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="Учебная почта" Foreground="#7A7886"/>
                                <TextBlock Text="123456@edu.fa.ru" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Контактная информация" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="10"/>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Телефон" Foreground="#7A7886"/>
                                <TextBlock Text="+7 (916) 123-45-67" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Дополнительная почта" Foreground="#7A7886"/>
                                <TextBlock Text="alex.petrov@example.com" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="Ссылка на Вконтакте" Foreground="#7A7886"/>
                                <TextBlock Text="vk.com/alexpetrov" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Портфолио" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="10"/>
                        <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                        <TextBlock Text="Загрузить документы" Foreground="White" Margin="0,0,0,15" FontFamily="Digital Pixel" FontSize="10"/>

                        <Grid Margin="0,0,0,15" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M3,2 L10,2 L14,6 L14,16 C14,17 13,18 12,18 L3,18 C2,18 1,17 1,16 L1,4 C1,3 2,2 3,2 Z M9,2 L9,7 L14,7" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="18" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Загрузить" Foreground="#D1CDEF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M3,2 L10,2 L14,6 L14,16 C14,17 13,18 12,18 L3,18 C2,18 1,17 1,16 L1,4 C1,3 2,2 3,2 Z M9,2 L9,7 L14,7" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="18" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Загрузить PDF" Foreground="#D1CDEF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Просмотр и выгрузка" Foreground="White" Margin="0,0,0,15" FontFamily="Digital Pixel" FontSize="10"/>

                        <Grid Margin="0,0,0,15" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M1,8 C3,4 7,2 11,2 C15,2 19,4 21,8 C19,12 15,14 11,14 C7,14 3,12 1,8 Z M11,5 C9.3,5 8,6.3 8,8 C8,9.7 9.3,11 11,11 C12.7,11 14,9.7 14,8 C14,6.3 12.7,5 11,5 Z" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="12" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Просмотреть портфолио" Foreground="#D1CDEF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M11,2 L11,12 M7,8 L11,12 L15,8 M5,16 L17,16" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Выгрузить портфолио в PDF" Foreground="#D1CDEF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>