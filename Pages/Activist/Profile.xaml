<Page x:Class="Diplom_Stud.Pages.Activist.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      Title="Profile Page" UseLayoutRounding="True" SnapsToDevicePixels="True" 
      d:DesignHeight="1300" d:DesignWidth="1111"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,30" MaxWidth="900" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BackButton" Content="&lt; Назад" Style="{StaticResource GhostButtonStyle}" Foreground="#A084FB" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Left" Margin="0,0,0,20" Visibility="Collapsed" Click="BackButton_Click"/>

                <Grid Grid.Row="1" Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="ProfilePhoto" Grid.Column="0" Width="100" Height="100" Margin="0,0,25,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Resources/prof.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NameTextBlock" Text="Загрузка..." Foreground="White" FontWeight="Bold" Margin="0,0,0,10" FontFamily="Digital Pixel" FontSize="26"/>
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                                <ToggleButton x:Name="btnRoleSwitch" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="RoleSwitch_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RoleTextBlock" Text="Загрузка роли..." Foreground="White" FontSize="13"/>
                                        <Path x:Name="RoleArrow" Data="M0,0 L4,4 L8,0" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" Margin="5,2,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup x:Name="RolePopup" PlacementTarget="{Binding ElementName=btnRoleSwitch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,5,0,0" MinWidth="150">
                                        <StackPanel>
                                            <Button Content="Координатор" Style="{StaticResource GhostButtonStyle}" Foreground="White" Click="SetCoordinatorRole_Click" HorizontalAlignment="Left" Margin="5"/>
                                            <Button Content="Активист" Style="{StaticResource GhostButtonStyle}" Foreground="#7A7886" Click="SetActivistRole_Click" HorizontalAlignment="Left" Margin="5"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <TextBlock x:Name="GroupTextBlock" Text="Группа: Загрузка..." Foreground="White" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="RatingGrid" Grid.Row="2" Columns="3" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="10,15">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Всего мероприятий:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="EventsCountTextBlock" Text="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="22"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="10,0,10,0" Padding="10,15">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Баллы рейтинга:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="PointsCountTextBlock" Text="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="22"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0" Padding="10,15">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Место в рейтинге:" Foreground="#02B3BA" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="RankTextBlock" Text="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Digital Pixel" FontSize="22"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid x:Name="ActionButtonsGrid" Grid.Row="3" Margin="0,0,0,30">
                    <Button Content="Редактировать" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Width="180" FontFamily="Digital Pixel" FontSize="11"/>
                    <Button Content="История баллов" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Width="182" Click="Button_Click" FontFamily="Digital Pixel" FontSize="11"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Общая информация" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="18" TextWrapping="Wrap"/>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Дата рождения:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="BirthDateTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Пол:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="GenderTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Учебная почта:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="StudentEmailTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Социальный статус:" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="SocialStatusesTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" LineHeight="20"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Контактная информация" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="18" TextWrapping="Wrap"/>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Телефон:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="PhoneTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Дополнительная почта:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="AdditionalEmailTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ссылка на Вконтакте:" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock x:Name="VkLinkTextBlock" Grid.Column="1" Text="Загрузка..." Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Портфолио" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="18"/>
                        <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                        <StackPanel x:Name="PortfolioUploadPanel">
                            <TextBlock Text="Загрузить документы" Foreground="White" Margin="0,0,0,15" FontFamily="Digital Pixel" FontSize="14"/>
                            <Grid Margin="0,0,0,15" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M3,2 L10,2 L14,6 L14,16 C14,17 13,18 12,18 L3,18 C2,18 1,17 1,16 L1,4 C1,3 2,2 3,2 Z M9,2 L9,7 L14,7" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="18" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="1" Text="Загрузить" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,25" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M3,2 L10,2 L14,6 L14,16 C14,17 13,18 12,18 L3,18 C2,18 1,17 1,16 L1,4 C1,3 2,2 3,2 Z M9,2 L9,7 L14,7" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="18" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="1" Text="Загрузить PDF" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Просмотр и выгрузка" Foreground="White" Margin="0,0,0,15" FontFamily="Digital Pixel" FontSize="14"/>
                        <Grid Margin="0,0,0,15" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M1,8 C3,4 7,2 11,2 C15,2 19,4 21,8 C19,12 15,14 11,14 C7,14 3,12 1,8 Z M11,5 C9.3,5 8,6.3 8,8 C8,9.7 9.3,11 11,11 C12.7,11 14,9.7 14,8 C14,6.3 12.7,5 11,5 Z" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="12" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Просмотреть портфолио" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,10" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M11,2 L11,12 M7,8 L11,12 L15,8 M5,16 L17,16" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Выгрузить портфолио в PDF" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AdminPanelGrid" Grid.Row="6" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Дополнительно" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="18"/>
                        <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonUp="Archive_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M3 3 L21 3 L21 7 L3 7 Z M4 7 L4 21 L20 21 L20 7 M9 12 L15 12" 
                  Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Архив мероприятий" Foreground="White" VerticalAlignment="Center" FontFamily="Montserrat"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonUp="Board_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M15 10 A3 3 0 1 0 15 4 A3 3 0 0 0 15 10 Z M20 19 C20 16 17.5 14 15 14 M9 12 A4 4 0 1 0 9 4 A4 4 0 0 0 9 12 Z M3 21 C3 16 6 13 9 13 C12 13 15 16 15 21" 
                  Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="14" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Правление студсовета" Foreground="White" VerticalAlignment="Center" FontFamily="Montserrat"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="About_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M12 22 C17.5 22 22 17.5 22 12 C22 6.5 17.5 2 12 2 C6.5 2 2 6.5 2 12 C2 17.5 6.5 22 12 22 Z M12 7 L12.01 7 M12 11 L12 17" 
                  Stroke="#02B3BA" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="О приложении" Foreground="White" VerticalAlignment="Center" FontFamily="Montserrat"/>
                            <TextBlock Grid.Column="2" Text=">" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="UserSectorsGrid" Grid.Row="7" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Состоит в секторах" Foreground="White" FontWeight="Medium" Margin="0,0,0,20" FontFamily="Digital Pixel" FontSize="18"/>
                        <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                        <ItemsControl x:Name="UserSectorsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" 
                                              Fill="#02B3BA" Stretch="Uniform" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="14" FontFamily="Montserrat" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoSectorsText" Text="Не состоит ни в одном секторе" Foreground="#7A7886" FontSize="13" FontFamily="Montserrat Thin" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка профиля..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>