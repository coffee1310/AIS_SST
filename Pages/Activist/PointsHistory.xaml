<Page x:Class="Diplom_Stud.Pages.Activist.PointsHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1111"
      Title="Points History"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#12101C"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12101C"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1B29"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="950" Margin="40,50,40,50">

                <TextBlock Text="История баллов" FontSize="42" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Grid Margin="0,0,0,50" MaxWidth="700">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M10,3 A7,7 0 1,0 17,10 A7,7 0 0,0 10,3 Z M15,15 L20,20" Stroke="#7A7886" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>

                            <TextBox x:Name="tbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" FontFamily="Montserrat Thin"/>

                            <TextBlock Grid.Column="1" Text="Название мероприятия" Foreground="#7A7886" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Montserrat Thin">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource FilterButtonStyle}" Width="50" Height="50">
                        <Canvas Width="16" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Line X1="0" Y1="3" X2="16" Y2="3" Stroke="White" StrokeThickness="1.5"/>
                            <Line X1="0" Y1="11" X2="16" Y2="11" Stroke="White" StrokeThickness="1.5"/>
                            <Ellipse Canvas.Left="3" Canvas.Top="0" Width="6" Height="6" Stroke="White" StrokeThickness="1.5" Fill="#12101C"/>
                            <Ellipse Canvas.Left="9" Canvas.Top="8" Width="6" Height="6" Stroke="White" StrokeThickness="1.5" Fill="#12101C"/>
                        </Canvas>
                    </Button>
                </Grid>

                <TextBlock Text="За мероприятия" FontSize="18" FontFamily="Digital Pixel" Foreground="White" Margin="10,0,0,10"/>

                <UniformGrid Columns="3" Margin="-10,0,-10,40">

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="День первокурсника" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Роль: Организатор" Foreground="#7A7886" FontSize="11" Margin="0,0,0,15" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="15 сентября 2023" Foreground="#02B3BA" FontSize="10" FontFamily="Montserrat Thin"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="+15" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Студенческая весна" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Роль: Участник" Foreground="#7A7886" FontSize="11" Margin="0,0,0,15" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="20 апреля 2023" Foreground="#02B3BA" FontSize="10" FontFamily="Montserrat Thin"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="+10" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Мисс и Мистер Колледж" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Роль: Волонтер" Foreground="#7A7886" FontSize="11" Margin="0,0,0,15" FontFamily="Montserrat Thin"/>
                                <TextBlock Text="10 марта 2023" Foreground="#02B3BA" FontSize="10" FontFamily="Montserrat Thin"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="+5" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <TextBlock Text="За быстрые задачи" FontSize="18" FontFamily="Digital Pixel" Foreground="White" Margin="10,0,0,10"/>

                <UniformGrid Columns="3" Margin="-10,0,-10,20">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Подготовить отчет по мероприятию" Foreground="White" FontSize="14" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="+5" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Разработать дизайн афиши" Foreground="White" FontSize="14" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="+5" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Написать пост в социальные сети" Foreground="White" FontSize="14" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="+5" Foreground="#02B3BA" FontSize="16" FontWeight="Bold" FontFamily="Digital Pixel" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>