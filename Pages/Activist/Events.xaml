<Page x:Class="Diplom_Stud.Pages.Activist.Events"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1111"
      Title="Events"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000" Margin="40,50,40,50">

                <TextBlock Text="Все мероприятия" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Grid Margin="0,0,0,50" Width="700">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M10,3 A7,7 0 1,0 17,10 A7,7 0 0,0 10,3 Z M15,15 L20,20" Stroke="#7A7886" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>

                            <TextBox x:Name="tbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" FontFamily="Montserrat Thin" TextChanged="tbSearch_TextChanged"/>

                            <TextBlock Grid.Column="1" Text="Название или место проведения..." Foreground="#7A7886" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Montserrat Thin">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource FilterButtonStyle}" Width="50" Height="50">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Rectangle Canvas.Left="1" Canvas.Top="3" Width="14" Height="12" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                            <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="White" StrokeThickness="1.5"/>
                            <Line X1="4" Y1="1" X2="4" Y2="4" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="12" Y1="1" X2="12" Y2="4" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                        </Canvas>
                    </Button>
                </Grid>

                <ItemsControl x:Name="EventsItemsControl" Margin="-10,0,-10,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventCardStyle}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" Cursor="Hand" MouseLeftButtonUp="EventCard_Click" Tag="{Binding Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Grid>
                                            <Border Background="#A084FB" CornerRadius="8" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Visibility="{Binding OrganizerBadgeVisibility}">
                                                <TextBlock Text="Вы организатор" Foreground="White" FontSize="10" FontFamily="Montserrat" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="15,15,15,20">
                                        <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor}" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Path Data="M8,0 A8,8 0 1,0 8,16 A8,8 0 0,0 8,0 Z M8,2 V8 L12,10" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding DateTimeDisplay}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Venue}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyEventsText" Text="Мероприятий пока нет." Foreground="#7A7886" FontFamily="Montserrat" FontSize="16" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="btnCreateEvent" Width="64" Height="64" Margin="0,0,40,40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Click="CreateEvent_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fabBorder" Background="#615292" CornerRadius="32">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="5" Color="Black"/>
                        </Border.Effect>
                        <TextBlock Text="+" Foreground="White" FontSize="40" FontFamily="Montserrat" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="fabBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                    To="#7363A8" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="fabBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                    To="#615292" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка мероприятий..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>