<Page x:Class="Diplom_Stud.Pages.Activist.SectorDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Sector Details"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <TextBlock Text="Сектор" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Grid Margin="0,0,0,50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="380" Height="220" CornerRadius="12" Margin="0,0,40,0" ClipToBounds="True" VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/sector1.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">

                        <TextBlock Text="Спортивный сектор" FontSize="24" FontFamily="Digital Pixel" Foreground="White" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Path Data="M8,8 C10.21,8 12,6.21 12,4 C12,1.79 10.21,0 8,0 C5.79,0 4,1.79 4,4 C4,6.21 5.79,8 8,8 Z M8,10 C5.33,10 0,11.34 0,14 L0,16 L16,16 L16,14 C16,11.34 10.67,10 8,10 Z" 
                                  Fill="Transparent" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Координатор" Foreground="#02B3BA" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <Ellipse Width="40" Height="40" Margin="0,0,15,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Resources/prof.png" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Литов Никита" Foreground="White" FontSize="14" FontFamily="Montserrat" Margin="0,0,0,3"/>
                                <TextBlock Text="студент группы 4ИСИП-322" Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Организация и проведение спортивных мероприятий, соревнований и тренировок. Мы стремимся к развитию физической культуры и здорового образа жизни среди студентов." 
                                   Foreground="#7A7886" FontSize="13" FontFamily="Montserrat Thin" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>

                <Button Content="Выйти из сектора" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="60,15" FontSize="14" Cursor="Hand"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>