<Page x:Class="Diplom_Stud.Pages.Activist.Sectors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Sectors"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Увеличил MaxWidth с 1000 до 1150, чтобы карточкам было куда расти вширь -->
            <StackPanel HorizontalAlignment="Center" MaxWidth="1400" Margin="40,50,40,50">

                <TextBlock Text="Сектора ССТ" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,60"/>

                <!-- Динамический список секторов -->
                <ItemsControl x:Name="SectorsItemsControl" Margin="0,0,0,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Добавил Margin="15", чтобы между большими карточками был воздух -->
                            <Border Style="{StaticResource EventCardStyle}" Cursor="Hand" MouseLeftButtonUp="SectorCard_Click" Tag="{Binding Id}" Margin="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Увеличил высоту картинки со 130 до 180, а также внутренние отступы до 20 -->
                                    <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="180" Margin="20,20,20,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="20,20,20,25">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Увеличил шрифт заголовка с 14 до 18 -->
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White" FontSize="18" FontFamily="Digital Pixel" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <!-- Увеличил шрифт описания с 10 до 12 и добавил LineHeight для лучшей читаемости -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="18"/>

                                        <!-- Кнопка статуса -->
                                        <Button Grid.Row="2" Content="{Binding ButtonText}" Style="{Binding ButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>