<Page x:Class="Diplom_Stud.Pages.Activist.Rating"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Rating"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <TextBlock Text="Рейтинг активистов" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Border Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="50" Width="400" HorizontalAlignment="Left" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="M10,3 A7,7 0 1,0 17,10 A7,7 0 0,0 10,3 Z M15,15 L20,20" Stroke="#7A7886" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>

                        <TextBox x:Name="tbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" FontFamily="Montserrat Thin"/>

                        <TextBlock Grid.Column="1" Text="Поиск" Foreground="#7A7886" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Montserrat Thin">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                                <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RatingTableContainerStyle}">
                    <StackPanel>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,0">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Место" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="ФИО" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin"/>
                                <TextBlock Grid.Column="2" Text="Роль" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin"/>
                                <TextBlock Grid.Column="3" Text="Баллы" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin"/>
                            </Grid>
                        </Border>

                        <Border Background="#37265D" BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#8B78BA" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Center">
                                    <TextBlock Text="1" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Иванова Марина Петровна" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#D1CDEF" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2500" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#2D1F4F" BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#7561A4" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Center">
                                    <TextBlock Text="2" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Козлов Сергей Владимирович" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Координатор сектора" Foreground="#D1CDEF" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2485" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#251A44" BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#615292" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Center">
                                    <TextBlock Text="3" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Крылова Полина Александровна" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#D1CDEF" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2370" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Смирнова Валентина Андреевна" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2265" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="5" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Воронин Максим Олегович" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2230" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="6" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Орлов Антон Романович" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2125" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="7" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Казакова Олеся Алексеевна" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="2000" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Padding="0,15">
                            <Grid Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="8" Foreground="White" FontSize="16" FontFamily="Montserrat Thin" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Назаров Дмитрий Викторович" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Активист" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="1985" Foreground="White" FontSize="14" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Margin="20,20,20,5">
                            <TextBlock Text="Всего активистов: 150" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="1" Style="{StaticResource PaginationActivePageButtonStyle}"/>
                                <Button Content="2" Style="{StaticResource PaginationPageButtonStyle}"/>
                                <Button Content="3" Style="{StaticResource PaginationPageButtonStyle}"/>
                                <TextBlock Text="..." Foreground="#7A7886" VerticalAlignment="Bottom" Margin="4,0" FontFamily="Montserrat Thin"/>
                                <Button Content="20" Style="{StaticResource PaginationPageButtonStyle}"/>

                                <Button Style="{StaticResource PurpleArrowButtonStyle}" Margin="10,0,5,0" Width="26" Height="26">
                                    <Path Data="M8,1 L2,6 L8,11 M2,6 L12,6" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="8"/>
                                </Button>
                                <Button Style="{StaticResource PurpleArrowButtonStyle}" Width="26" Height="26">
                                    <Path Data="M4,1 L10,6 L4,11 M10,6 L0,6" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="8"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>