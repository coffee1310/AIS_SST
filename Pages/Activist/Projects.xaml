<Page x:Class="Diplom_Stud.Pages.Activist.Projects"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Projects"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000" Margin="40,50,40,50">

                <TextBlock Text="Внутренние проекты" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,60"/>

                <Grid Margin="0,0,0,60" MaxWidth="700">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M10,3 A7,7 0 1,0 17,10 A7,7 0 0,0 10,3 Z M15,15 L20,20" Stroke="#7A7886" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>

                            <TextBox x:Name="tbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" FontFamily="Montserrat Thin"/>

                            <TextBlock Grid.Column="1" Text="Название проекта" Foreground="#7A7886" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Montserrat Thin">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource FilterButtonStyle}" Width="50" Height="50">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Rectangle Canvas.Left="1" Canvas.Top="3" Width="14" Height="12" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                            <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="White" StrokeThickness="1.5"/>
                            <Line X1="4" Y1="1" X2="4" Y2="4" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="12" Y1="1" X2="12" Y2="4" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="White" RadiusX="0.5" RadiusY="0.5"/>
                        </Canvas>
                    </Button>
                </Grid>

                <UniformGrid Columns="3" Margin="0,0,0,60">

                    <Border Style="{StaticResource EventCardStyle}" Cursor="Hand" MouseLeftButtonUp="ProjectCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project1.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Школа Актива" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Курс для начинающих активистов. Научим основам проектной деятельности и работы в команде." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EventCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project2.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Медиашкола" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Обучение созданию контента, работе с соцсетями и продвижению мероприятий. Для будущих SMM-специалистов." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EventCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project3.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Школа организаторов" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Всё об организации мероприятий от А до Я. Планирование, бюджетирование, поиск партнеров и работа с волонтерами." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EventCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project4.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Школа старост" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Развитие лидерских качеств, эффективная коммуникация с учебной частью и одногруппниками, решение конфликтов." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EventCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project5.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Школа наставничества" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Как стать другом и проводником для первокурсников. Психологические основы адаптации, игровые методики и секреты успешного кураторства." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EventCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/project6.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="1" Margin="15,15,15,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Школа волонтеров" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Обучение основам добровольческой деятельности: от помощи на мероприятиях до самостоятельной организации социальных проектов." Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,25"/>
                                <Button Grid.Row="2" Content="Подробнее" Style="{StaticResource SectorActiveButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>