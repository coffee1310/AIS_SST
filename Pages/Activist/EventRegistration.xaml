<Page x:Class="Diplom_Stud.Pages.Activist.EventRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d"
      d:DesignHeight="1000" d:DesignWidth="1111"
      Title="Event Registration"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="RoleCardCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#12101C"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <Border x:Name="checkIndicator" Width="22" Height="22" BorderBrush="#02B3BA" BorderThickness="1.5" CornerRadius="4" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Path x:Name="checkMark" Data="M4,10 L9,14 L16,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden" Stretch="Uniform" Margin="4"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D254A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B3D80"/>
                                <Setter TargetName="checkIndicator" Property="Background" Value="#02B3BA"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1050" Margin="40,50,40,50">

                <Button x:Name="BackButton" Content="&lt; Назад" Style="{StaticResource GhostButtonStyle}" Foreground="#A084FB" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Left" Click="BackButton_Click" Margin="0,0,0,10"/>

                <TextBlock Text="Мероприятие" FontSize="36" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <TextBlock x:Name="EventTitleText" Text="Загрузка..." FontSize="24" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock Text="Выберите, как Вы хотите помочь сделать это событие незабываемым!" Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,50" TextWrapping="Wrap" TextAlignment="Center"/>

                <ItemsControl x:Name="RolesItemsControl" Margin="-10,0,-10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource RoleCardCheckBoxStyle}" 
                                      Margin="10" 
                                      Tag="{Binding Id}"
                                      Opacity="{Binding CardOpacity}"
                                      IsEnabled="{Binding IsActive}"
                                      Checked="Role_Checked" 
                                      Unchecked="Role_Unchecked">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Path Data="M8,1 A7,7 0 1,0 8,15 A7,7 0 0,0 8,1 Z M8,4 L8,8 L11,10" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding DeadlineText}" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Description}" Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ApplicationStatus}" Foreground="#E81123" FontSize="11" FontFamily="Montserrat" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding SlotsInfo}" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyRolesText" Text="Нет доступных ролей для регистрации." Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed"/>

                <TextBlock Text="* Если вы не выберете ни одну из ролей выше, вы будете зарегистрированы как обычный участник." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0"/>

                <Border Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="12" Margin="0,30,0,40" MaxWidth="700" HorizontalAlignment="Stretch" Padding="15">
                    <Grid>
                        <TextBlock Text="Оставьте комментарий или пожелание к роли"
                                   Foreground="#4A485C" FontFamily="Montserrat Thin" FontSize="14" IsHitTestVisible="False" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbComment}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="tbComment" Background="Transparent" BorderThickness="0" Foreground="White"
                                 FontFamily="Montserrat Thin" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="80" CaretBrush="White"/>
                    </Grid>
                </Border>

                <Button x:Name="SubmitBtn" Content="Отправить заявку" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="60,15" FontSize="14" Click="SubmitBtn_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>