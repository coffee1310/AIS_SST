<Page x:Class="Diplom_Stud.Pages.Activist.EventRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1111"
      Title="Event Registration"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1050" Margin="40,50,40,50">

                <TextBlock Text="Мероприятие" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Вечер талантов" FontSize="24" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Выберите, как Вы хотите помочь сделать это событие незабываемым!" Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <UniformGrid Columns="3" Margin="-10,0,-10,0">

                    <RadioButton Style="{StaticResource RoleCardRadioButtonStyle}" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Организатор" Foreground="White" FontSize="16" FontFamily="Montserrat"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M8,1 A7,7 0 1,0 8,15 A7,7 0 0,0 8,1 Z M8,4 L8,8 L11,10" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0"/>
                                    <TextBlock Text="10 мая" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="• Координация всех этапов мероприятия." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Связь с участниками и волонтерами." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Решение организационных вопросов." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RoleCardRadioButtonStyle}" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="Волонтер" Foreground="White" FontSize="16" FontFamily="Montserrat"/>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="• Помощь в расстановке оборудования." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Встреча и регистрация гостей." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Поддержание порядка в зале." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RoleCardRadioButtonStyle}" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Выступающий" Foreground="White" FontSize="16" FontFamily="Montserrat"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M8,1 A7,7 0 1,0 8,15 A7,7 0 0,0 8,1 Z M8,4 L8,8 L11,10" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0"/>
                                    <TextBlock Text="12 мая" Foreground="#02B3BA" FontSize="12" FontFamily="Montserrat Thin"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="• Подготовка и репетиция номера." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Своевременное прибытие на саундчек." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock Text="• Выступление согласно программе." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                </UniformGrid>

                <Border Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="12" Margin="0,30,0,40" MaxWidth="700" HorizontalAlignment="Stretch" Padding="15">
                    <Grid>
                        <TextBlock Text="Оставьте комментарий или пожелание к роли" 
                                   Foreground="#4A485C" FontFamily="Montserrat Thin" FontSize="14" IsHitTestVisible="False" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbComment}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="tbComment" Background="Transparent" BorderThickness="0" Foreground="White" 
                                 FontFamily="Montserrat Thin" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" 
                                 MinHeight="80" CaretBrush="White"/>
                    </Grid>
                </Border>

                <Button Content="Отправить заявку" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="60,15" FontSize="14"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>