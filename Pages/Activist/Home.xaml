<Page x:Class="Diplom_Stud.Pages.Activist.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" d:DesignWidth="1111" d:DesignHeight="1280"
      Title="Home"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000" Margin="40,50,40,50">

                <TextBlock Text="Добро пожаловать!" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="tbUserName" Text="Загрузка..." FontSize="20" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Всего мероприятий:" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="tbEventsCount" Text="0" Foreground="White" FontSize="18" FontFamily="Digital Pixel" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Баллы рейтинга:" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="tbPointsCount" Text="0" Foreground="White" FontSize="18" FontFamily="Digital Pixel" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Место в рейтинге:" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="tbRank" Text="0" Foreground="White" FontSize="18" FontFamily="Digital Pixel" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Margin="10,0,10,20">
                    <TextBlock Text="Мероприятия" FontSize="24" FontFamily="Digital Pixel" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Все мероприятия" Style="{StaticResource PurpleOutlineButtonStyle}" Margin="0,0,15,0" Click="AllEvents_Click"/>
                        <Button x:Name="BtnPrevEvent" Click="BtnPrevEvent_Click" Style="{StaticResource PurpleArrowButtonStyle}" Margin="0,0,10,0" Visibility="Collapsed">
                            <Path Data="M10,1 L4,7 L10,13 M4,7 L16,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                        <Button x:Name="BtnNextEvent" Click="BtnNextEvent_Click" Style="{StaticResource PurpleArrowButtonStyle}" Visibility="Collapsed">
                            <Path Data="M6,1 L12,7 L6,13 M12,7 L0,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="EventsItemsControl" Margin="0,0,0,60" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventCardStyle}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" Cursor="Hand" MouseLeftButtonUp="EventCard_Click" Tag="{Binding Id}" Width="300" Height="290" Margin="0,0,20,0" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Grid>
                                            <Border Background="#A084FB" CornerRadius="8" Padding="12,6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                Margin="0,10,10,0" Visibility="{Binding OrganizerBadgeVisibility}">
                                                <TextBlock Text="Вы организатор" Foreground="White" FontSize="10" FontFamily="Montserrat" FontWeight="Bold"/>
                                            </Border>

                                            <Border Background="#02B3BA" CornerRadius="8" Padding="12,6" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                    Margin="10,10,0,0" Visibility="{Binding ParticipantBadgeVisibility}">
                                                <TextBlock Text="Вы участник" Foreground="White" FontSize="10" FontFamily="Montserrat" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="15,15,15,20">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Path Data="M8,0 A8,8 0 1,0 8,16 A8,8 0 0,0 8,0 Z M8,2 V8 L12,10" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding DateTimeDisplay}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Venue}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Venue}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyEventsText" Text="Доступных мероприятий пока нет."
                           Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,-40,0,60" Visibility="Collapsed"/>


                <Grid Margin="10,0,10,20">
                    <TextBlock Text="Текущие задачи" FontSize="24" FontFamily="Digital Pixel" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Все задачи" Style="{StaticResource PurpleOutlineButtonStyle}" Margin="0,0,15,0" Click="AllTasks_Click"/>
                        <Button x:Name="BtnPrevTask" Click="BtnPrevTask_Click" Style="{StaticResource PurpleArrowButtonStyle}" Margin="0,0,10,0" Visibility="Collapsed">
                            <Path Data="M10,1 L4,7 L10,13 M4,7 L16,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                        <Button x:Name="BtnNextTask" Click="BtnNextTask_Click" Style="{StaticResource PurpleArrowButtonStyle}" Visibility="Collapsed">
                            <Path Data="M6,1 L12,7 L6,13 M12,7 L0,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="TasksItemsControl" Margin="0,0,0,40" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,20,0" Width="300" Height="220" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Task.title}" Foreground="White" FontSize="16" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" MaxHeight="40"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Task.description}" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" TextWrapping="Wrap"/>
                                    </ScrollViewer>

                                    <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Task.DeadlineDisplay}" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Task.PointsDisplay}" Foreground="#FFA500" FontSize="11" FontFamily="Montserrat" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Content="{Binding ActionText}" 
                                                Background="{Binding ActionBackground}"
                                                Foreground="{Binding ActionForeground}"
                                                BorderThickness="0"
                                                Padding="12,6"
                                                FontFamily="Montserrat"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right" 
                                                HorizontalAlignment="Right" 
                                                Tag="{Binding}" 
                                                Click="TaskAction_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyTasksText" Text="Доступных задач пока нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,-20,0,40" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>