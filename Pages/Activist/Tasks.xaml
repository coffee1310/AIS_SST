<Page x:Class="Diplom_Stud.Pages.Activist.Tasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tasks"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000" Margin="40,50,40,50">

                <TextBlock Text="Задачи" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <RadioButton x:Name="TabAvailable" Content="Доступные задачи" IsChecked="True" Style="{StaticResource MenuRadioButtonStyle}" Checked="Tab_Checked" Margin="0,0,20,0"/>
                    <RadioButton x:Name="TabMine" Content="Мои задачи" Style="{StaticResource MenuRadioButtonStyle}" Checked="Tab_Checked"/>
                </StackPanel>

                <Grid Margin="0,0,0,40" MaxWidth="700">
                    <Border Background="#12101C" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M10,3 A7,7 0 1,0 17,10 A7,7 0 0,0 10,3 Z M15,15 L20,20" Stroke="#7A7886" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                            <TextBox x:Name="tbSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalContentAlignment="Center" FontFamily="Montserrat Thin" TextChanged="TbSearch_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="Поиск задачи..." Foreground="#7A7886" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Montserrat Thin">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <ItemsControl x:Name="TasksList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Margin="-10,0,-10,40"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10" Height="220">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Task.title}" Foreground="White" FontSize="16" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Task.description}" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" TextWrapping="Wrap"/>
                                    </ScrollViewer>

                                    <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Task.DeadlineDisplay}" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Task.PointsDisplay}" Foreground="#FFA500" FontSize="11" FontFamily="Montserrat" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Content="{Binding ActionText}" 
                                                Background="{Binding ActionBackground}"
                                                Foreground="{Binding ActionForeground}"
                                                BorderThickness="0"
                                                Padding="12,6"
                                                FontFamily="Montserrat"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right" 
                                                HorizontalAlignment="Right" 
                                                Tag="{Binding}" 
                                                Click="TaskAction_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Задач пока нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0"/>
        </Grid>
    </Grid>
</Page>