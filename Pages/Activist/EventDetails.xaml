<Page x:Class="Diplom_Stud.Pages.Activist.EventDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Activist"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Event Details"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <Grid Margin="0,0,0,30">
                    <Button x:Name="BackButton" Content="&lt; Назад" Style="{StaticResource GhostButtonStyle}" Foreground="#A084FB" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Left" Click="BackButton_Click"/>
                    <TextBlock Text="Мероприятие" FontSize="36" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="380" Height="220" CornerRadius="12" Margin="0,0,40,0" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="EventImageBrush" ImageSource="/Resources/event1.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="EventTitleText" Text="Загрузка..." FontSize="24" FontFamily="Digital Pixel" Foreground="White" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="M2,2 L14,2 L14,14 L2,14 Z M2,5 L14,5" Stroke="#02B3BA" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="EventTimeText" Text="Загрузка времени..." Foreground="White" FontSize="14" FontFamily="Montserrat Thin"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="16" Margin="1,0,10,0"/>
                            <TextBlock x:Name="EventVenueText" Text="Загрузка места..." Foreground="White" FontSize="14" FontFamily="Montserrat Thin" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="EventDescriptionText" Text="Загрузка описания..." 
                                   Foreground="#7A7886" FontSize="13" FontFamily="Montserrat Thin" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Роли и задачи" FontSize="20" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <ItemsControl x:Name="RolesItemsControl" Margin="-10,0,-10,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TaskCardStyle}" Margin="10,0,10,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="16"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Path Data="M8,1 A7,7 0 1,0 8,15 A7,7 0 0,0 8,1 Z M8,4 L8,8 L11,10" Stroke="#02B3BA" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DeadlineText}" Foreground="#02B3BA" FontSize="11" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyRolesText" Text="Роли пока не назначены." Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed"/>

                <Button Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="50,15" Cursor="Hand" Click="RegisterButton_Click">
                    <TextBlock Text="Зарегистрироваться на мероприятие" TextAlignment="Center" FontSize="14" FontFamily="Digital Pixel" Foreground="White" LineHeight="20"/>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>