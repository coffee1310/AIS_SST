<Page x:Class="Diplom_Stud.Pages.Coordinator.EventParticipantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid>
        <StackPanel>
            <TextBlock Text="Утвержденные участники" Foreground="White" FontSize="20" FontFamily="Digital Pixel" Margin="0,0,0,20"/>
            <ItemsControl x:Name="RolesWithParticipantsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{Binding RoleTitle}" Foreground="#02B3BA" FontSize="18" FontFamily="Digital Pixel" VerticalAlignment="Center"/>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Right" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock Text="Свернуть/Развернуть" Foreground="#7A7886" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Participants}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}" BorderBrush="#2A283C" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="15,10,15,15" Cursor="Hand" MouseLeftButtonUp="ParticipantCard_Click" Tag="{Binding StudentId}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="Medium" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding StudentEmail}" Foreground="#02B3BA" FontFamily="Montserrat Thin" FontSize="12" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding StatusLabel}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Content="Исключить" Style="{StaticResource OutlineButtonStyle}" Foreground="#E81123" BorderBrush="#E81123" Height="32" Padding="15,0" FontSize="12" VerticalAlignment="Center" Tag="{Binding ParticipantId}" Click="KickParticipant_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyParticipantsText" Text="Участников пока нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>