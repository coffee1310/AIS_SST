<Page x:Class="Diplom_Stud.Pages.Coordinator.CoordinatorEventDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление мероприятием" Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A7886"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Rectangle x:Name="ActiveIndicator" Height="2" Fill="Transparent" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ActiveIndicator" Property="Fill" Value="#02B3BA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <Grid Margin="0,0,0,30">
                    <Button x:Name="BackButton" Content="&lt; Назад" Style="{StaticResource GhostButtonStyle}" Foreground="#A084FB" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Click="BackButton_Click"/>
                    <TextBlock Text="Управление мероприятием" FontSize="30" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="EventTitleHeader" Text="Загрузка..." FontSize="20" FontFamily="Digital Pixel" Foreground="#02B3BA" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,40" HorizontalAlignment="Center">
                    <RadioButton x:Name="TabEdit" Content="Данные" Style="{StaticResource TabRadioButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabRequests" Content="Заявки" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabParticipants" Content="Участники" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFinalize" Content="Завершение" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                </StackPanel>

                <Frame x:Name="EventMainFrame" NavigationUIVisibility="Hidden" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>