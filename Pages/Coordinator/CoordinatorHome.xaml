<Page x:Class="Diplom_Stud.Pages.Coordinator.CoordinatorHome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="1111"
      Title="Coordinator Home"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000" Margin="40,50,40,50">

                <TextBlock Text="Добро пожаловать!" FontSize="64" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="tbUserName" Text="Загрузка..." FontSize="20" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,50">
                    <ToggleButton x:Name="btnRoleSwitch" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="RoleSwitch_Click">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Я - координатор" Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#7A7886" StrokeThickness="1.5" VerticalAlignment="Center" Margin="8,2,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <Popup x:Name="RolePopup" PlacementTarget="{Binding ElementName=btnRoleSwitch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,5,0,0" MinWidth="150">
                            <StackPanel>
                                <Button Content="Я - координатор" Style="{StaticResource GhostButtonStyle}" Foreground="White" HorizontalAlignment="Left" Margin="5"/>
                                <Button Content="Я - активист" Style="{StaticResource GhostButtonStyle}" Foreground="#7A7886" HorizontalAlignment="Left" Margin="5" Click="SetActivistRole_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Grid x:Name="DraftsHeaderGrid" Margin="10,0,10,20">
                    <TextBlock Text="Мои черновики" FontSize="24" FontFamily="Digital Pixel" Foreground="#A084FB" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PurpleArrowButtonStyle}" Margin="0,0,10,0">
                            <Path Data="M10,1 L4,7 L10,13 M4,7 L16,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource PurpleArrowButtonStyle}">
                            <Path Data="M6,1 L12,7 L6,13 M12,7 L0,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="DraftsItemsControl" Margin="0,0,0,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventCardStyle}" BorderBrush="#574596" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DraftCard_Click" Tag="{Binding Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="12" Height="130" Margin="15,15,15,0" Background="#1C1B29" ClipToBounds="True">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
                                                <Path Data="M19,4h-3.17L14,2H10L8.17,4H5C3.9,4 3,4.9 3,6v12c0,1.1 0.9,2 2,2h14c1.1,0 2-0.9 2-2V6C21,4.9 20.1,4 19,4z" Fill="#574596" Stretch="Uniform" Width="30" Height="25" Margin="0,0,0,10"/>
                                                <TextBlock Text="Без обложки" Foreground="#7A7886" FontSize="12" FontFamily="Montserrat Thin" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Visibility="{Binding ImageVisibility}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="15,15,15,20">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <Button Content="Продолжить создание" Style="{StaticResource OutlineButtonStyle}" Foreground="#A084FB" BorderBrush="#A084FB" Padding="0" Height="30" FontSize="10" Click="EditDraft_Click" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="10,0,10,20">
                    <TextBlock Text="Мои мероприятия" FontSize="24" FontFamily="Digital Pixel" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Все мероприятия" Style="{StaticResource PurpleOutlineButtonStyle}" Margin="0,0,15,0" Click="AllEvents_Click"/>
                        <Button Style="{StaticResource PurpleArrowButtonStyle}" Margin="0,0,10,0">
                            <Path Data="M10,1 L4,7 L10,13 M4,7 L16,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource PurpleArrowButtonStyle}">
                            <Path Data="M6,1 L12,7 L6,13 M12,7 L0,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="EventsItemsControl" Margin="0,0,0,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventCardStyle}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" Cursor="Hand" MouseLeftButtonUp="EventCard_Click" Tag="{Binding Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Height="130" Margin="15,15,15,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="15,15,15,20">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontFamily="Digital Pixel" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Path Data="M8,0 A8,8 0 1,0 8,16 A8,8 0 0,0 8,0 Z M8,2 V8 L12,10" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding DateTimeDisplay}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,0 C3.5,0 0,3.5 0,8 C0,13.5 8,16 8,16 C8,16 16,13.5 16,8 C16,3.5 12.5,0 8,0 Z M8,11 A3,3 0 1,1 8,5 A3,3 0 0,1 8,11 Z" Stroke="#02B3BA" StrokeThickness="1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Venue}" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyEventsText" Text="Мероприятий пока нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,-40,0,60" Visibility="Collapsed"/>


                <Grid Margin="10,0,10,20">
                    <TextBlock Text="Текущие задачи" FontSize="24" FontFamily="Digital Pixel" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Все задачи" Style="{StaticResource PurpleOutlineButtonStyle}" Margin="0,0,15,0"/>
                        <Button Style="{StaticResource PurpleArrowButtonStyle}" Margin="0,0,10,0">
                            <Path Data="M10,1 L4,7 L10,13 M4,7 L16,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource PurpleArrowButtonStyle}">
                            <Path Data="M6,1 L12,7 L6,13 M12,7 L0,7" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource TaskCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Помощь в организации мероприятия" Foreground="White" FontSize="14" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="Требуется помощь в расстановке стульев и оборудования..." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,15"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="до 3 июня" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <Button Content="Откликнуться" Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource TaskCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Разработка афиши" Foreground="White" FontSize="14" FontFamily="Digital Pixel" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="Нужен дизайнер для создания яркой афиши для предстоящего концерта..." Foreground="#7A7886" FontSize="11" FontFamily="Montserrat Thin" TextWrapping="Wrap" Margin="0,0,0,15"/>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="до 10 июня" Foreground="#7A7886" FontSize="10" FontFamily="Montserrat Thin" VerticalAlignment="Center"/>
                                <Button Content="Откликнуться" Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>