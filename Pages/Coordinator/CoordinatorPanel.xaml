<Page x:Class="Diplom_Stud.Pages.Coordinator.CoordinatorPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Coordinator Panel"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A7886"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <Rectangle x:Name="ActiveIndicator" Height="2" Fill="Transparent" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ActiveIndicator" Property="Fill" Value="#02B3BA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <TextBlock Text="Управление сектором" FontSize="40" FontFamily="Digital Pixel" Foreground="White" Margin="0,0,0,40"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <RadioButton x:Name="TabEdit" Content="Настройки" Style="{StaticResource TabRadioButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabParticipants" Content="Участники" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabRequests" Content="Заявки" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                </StackPanel>

                <Grid x:Name="GridEdit" Visibility="Visible">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Обложка сектора" Foreground="White" FontFamily="Montserrat" FontSize="16" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="200" Height="120" CornerRadius="8" ClipToBounds="True" Margin="0,0,20,0" BorderBrush="#2A283C" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush x:Name="EditSectorImage" Stretch="UniformToFill" ImageSource="/Resources/sector.png"/>
                                    </Border.Background>
                                </Border>
                                <Button Grid.Column="1" Content="Загрузить новое" Style="{StaticResource OutlineButtonStyle}" VerticalAlignment="Center" Click="UploadImage_Click"/>
                            </Grid>

                            <TextBlock Text="Описание сектора" Foreground="White" FontFamily="Montserrat" FontSize="16" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource RegInputBorderStyle}" Height="120" Margin="0,0,0,30">
                                <TextBox x:Name="EditDescriptionBox" Style="{StaticResource RegInnerInputStyle}" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top" Padding="15,15"/>
                            </Border>

                            <Button Content="Сохранить изменения" Style="{StaticResource RegModernButtonStyle}" HorizontalAlignment="Left" Click="SaveSector_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="GridParticipants" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource RegInputBorderStyle}" Margin="0,0,15,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource RegInnerInputStyle}" Tag="Поиск по ФИО или группе..."/>
                            </Border>
                            <Button Grid.Column="1" Content="Найти" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="SearchParticipants_Click"/>
                        </Grid>

                        <ItemsControl x:Name="ParticipantsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="Medium" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding GroupAndEmail}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Исключить" Style="{StaticResource OutlineButtonStyle}" Foreground="#E81123" BorderBrush="#E81123" VerticalAlignment="Center" Tag="{Binding Id}" Click="RemoveParticipant_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyParticipantsText" Text="Участники не найдены." Foreground="#7A7886" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="GridRequests" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="RequestsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="Medium" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding GroupAndEmail}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Принять" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Tag="{Binding RequestId}" Click="ApproveRequest_Click"/>
                                                <Button Content="Отклонить" Style="{StaticResource OutlineButtonStyle}" Foreground="#E81123" BorderBrush="#E81123" Tag="{Binding RequestId}" Click="RejectRequest_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyRequestsText" Text="Актуальных заявок нет." Foreground="#7A7886" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>