<Page x:Class="Diplom_Stud.Pages.Coordinator.EventFinalizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Title="Event Finalize">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="BgBorder" CornerRadius="12" Background="#12101C" BorderThickness="1.5" BorderBrush="#2A283C"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#7A7886" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#002A30"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#02B3BA"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#02B3BA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20,40,80">
                <TextBlock Text="Завершение мероприятия" Foreground="White" FontSize="36" FontFamily="Digital Pixel" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Отметьте присутствующих и проверьте начисленные баллы" Foreground="#7A7886" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <ItemsControl x:Name="RolesWithParticipantsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="{Binding RoleTitle}" Foreground="#02B3BA" FontSize="18" FontFamily="Digital Pixel" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Right" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <TextBlock Text="Свернуть/Развернуть" Foreground="#7A7886" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,10"/>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Participants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" BorderBrush="#2A283C" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="15,10,15,15">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ParticipantCard_Click" Tag="{Binding StudentId}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="Medium" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding TypeDisplay}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Баллы:" Foreground="#7A7886" FontFamily="Montserrat" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                <Border Style="{StaticResource RegInputBorderStyle}" Width="60" Height="36">
                                                                    <TextBox Text="{Binding Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                             Style="{StaticResource RegInnerInputStyle}" 
                                                                             TextAlignment="Center" Padding="0"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Присутствовал(а)" Foreground="White" FontFamily="Montserrat" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                <CheckBox IsChecked="{Binding WasPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchStyle}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyParticipantsText" Text="Участников нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <Button x:Name="btnExportWord" Content="Отчет в Word" Style="{StaticResource OutlineButtonStyle}" Foreground="#2B579A" BorderBrush="#2B579A" Padding="20,15" Margin="0,0,15,0" Click="ExportWord_Click"/>
                    <Button x:Name="btnExportExcel" Content="Отчет в Excel" Style="{StaticResource OutlineButtonStyle}" Foreground="#217346" BorderBrush="#217346" Padding="20,15" Margin="0,0,15,0" Click="ExportExcel_Click"/>
                    <Button x:Name="btnFinalize" Content="Завершить мероприятие" Style="{StaticResource PillButtonStyle}" Padding="40,15" FontSize="14" Click="FinalizeEvent_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Сохранение данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>