<Page x:Class="Diplom_Stud.Pages.Coordinator.EventFinalizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <Grid>
        <StackPanel>
            <TextBlock Text="Начисление баллов и завершение" Foreground="White" FontSize="20" FontFamily="Digital Pixel" Margin="0,0,0,15"/>
            <TextBlock Text="Укажите баллы каждому участнику. После завершения мероприятия изменить баллы будет нельзя." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" Margin="0,0,0,30" TextWrapping="Wrap"/>

            <ItemsControl x:Name="FinalizeListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,15,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="15" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding RoleTitle}" Foreground="#02B3BA" FontFamily="Montserrat Thin" FontSize="12"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource RegInputBorderStyle}" Height="40">
                                    <TextBox Text="{Binding Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" TextAlignment="Center" Tag="Баллы"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Завершить мероприятие" Background="#E81123" Foreground="White" BorderThickness="0" Padding="20,15" FontSize="16" FontFamily="Digital Pixel" Cursor="Hand" Margin="0,30,0,0" HorizontalAlignment="Center" Width="300" Click="FinalizeEvent_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Page>