<Page x:Class="Diplom_Stud.Pages.Coordinator.EventRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid>
        <StackPanel>
            <TextBlock Text="Управление заявками" Foreground="White" FontSize="20" FontFamily="Digital Pixel" Margin="0,0,0,20"/>
            <ItemsControl x:Name="RolesWithRequestsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{Binding RoleTitle}" Foreground="#A084FB" FontSize="18" FontFamily="Digital Pixel" VerticalAlignment="Center"/>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Right" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock Text="Свернуть/Развернуть" Foreground="#7A7886" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,10"/>
                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Applications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2A283C" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,15" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="RequestCard_Click" Tag="{Binding StudentId}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0" VerticalAlignment="Top">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="Medium" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding StudentEmail}" Foreground="#02B3BA" FontFamily="Montserrat Thin" FontSize="12" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Comment}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" TextWrapping="Wrap" Visibility="{Binding CommentVisibility}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Одобрить" Style="{StaticResource OutlineButtonStyle}" Foreground="#00C853" BorderBrush="#00C853" Height="32" Padding="15,0" Margin="0,0,10,0" Tag="{Binding ApplicationId}" Click="ApproveRequest_Click"/>

                                                            <Button Content="В резерв" Style="{StaticResource OutlineButtonStyle}" Foreground="#A084FB" BorderBrush="#A084FB" Height="32" Padding="15,0" Margin="0,0,10,0" Tag="{Binding ApplicationId}" Click="ReserveRequest_Click"/>

                                                            <Button Content="Отклонить" Style="{StaticResource OutlineButtonStyle}" Foreground="#E81123" BorderBrush="#E81123" Height="32" Padding="15,0" Tag="{Binding ApplicationId}" Click="RejectRequest_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyAllText" Text="Заявок на рассмотрении пока нет." Foreground="#7A7886" FontFamily="Montserrat" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed">
                <Button x:Name="BtnPrevPage" Content="&lt;" Style="{StaticResource PaginationPageButtonStyle}" Click="PrevPage_Click" Margin="0,0,15,0"/>
                <TextBlock x:Name="TxtPageInfo" Text="Стр 1" Foreground="#7A7886" VerticalAlignment="Center"/>
                <Button x:Name="BtnNextPage" Content="&gt;" Style="{StaticResource PaginationPageButtonStyle}" Click="NextPage_Click" Margin="15,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed" Panel.ZIndex="30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>