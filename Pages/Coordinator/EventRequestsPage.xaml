<Page x:Class="Diplom_Stud.Pages.Coordinator.EventRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d"
      d:DesignHeight="1000" d:DesignWidth="1111"
      Title="Event Requests"
      Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <StackPanel>
            <!-- Заголовок в стиле участников -->
            <TextBlock Text="Заявки на роли в мероприятии" 
                       Foreground="White" 
                       FontSize="20" 
                       FontFamily="Digital Pixel" 
                       Margin="0,0,0,20"/>

            <!-- Список заявок по ролям -->
            <ItemsControl x:Name="RolesWithRequestsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Название роли + кнопка сворачивания -->
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{Binding RoleTitle}" 
                                               Foreground="#02B3BA" 
                                               FontSize="18" 
                                               FontFamily="Digital Pixel" 
                                               VerticalAlignment="Center"/>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" 
                                                  HorizontalAlignment="Right" 
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock Text="Свернуть/Развернуть" 
                                                           Foreground="#7A7886" 
                                                           FontFamily="Montserrat" 
                                                           FontSize="14" 
                                                           VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,10"/>

                                <!-- Список заявок внутри роли -->
                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Applications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}" 
                                                        BorderBrush="#2A283C" 
                                                        BorderThickness="0,0,0,1" 
                                                        Margin="0,0,0,10" 
                                                        Padding="15,10,15,15" 
                                                        Cursor="Hand" 
                                                        MouseLeftButtonUp="RequestCard_Click" 
                                                        Tag="{Binding StudentId}">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Аватар -->
                                                        <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <!-- Информация -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" 
                                                                       Foreground="White" 
                                                                       FontFamily="Montserrat" 
                                                                       FontSize="16" 
                                                                       FontWeight="Medium" 
                                                                       Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding StudentEmail}" 
                                                                       Foreground="#02B3BA" 
                                                                       FontFamily="Montserrat Thin" 
                                                                       FontSize="12" 
                                                                       Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding Comment}" 
                                                                       Foreground="#7A7886" 
                                                                       FontFamily="Montserrat Thin" 
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <!-- Кнопки действий -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                            <Button Content="Одобрить" 
                                                                    Style="{StaticResource OutlineButtonStyle}" 
                                                                    Foreground="#00C853" 
                                                                    BorderBrush="#00C853" 
                                                                    Height="32" 
                                                                    Padding="15,0" 
                                                                    FontSize="12" 
                                                                    Margin="0,0,8,0"
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="ApproveRequest_Click"/>

                                                            <Button Content="Отклонить" 
                                                                    Style="{StaticResource OutlineButtonStyle}" 
                                                                    Foreground="#E81123" 
                                                                    BorderBrush="#E81123" 
                                                                    Height="32" 
                                                                    Padding="15,0" 
                                                                    FontSize="12" 
                                                                    Margin="0,0,8,0"
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="RejectRequest_Click"/>

                                                            <Button Content="В резерв" 
                                                                    Style="{StaticResource OutlineButtonStyle}" 
                                                                    Foreground="#FFA500" 
                                                                    BorderBrush="#FFA500" 
                                                                    Height="32" 
                                                                    Padding="15,0" 
                                                                    FontSize="12"
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="ReserveRequest_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyAllText" 
                       Text="Заявки пока отсутствуют." 
                       Foreground="#7A7886" 
                       FontFamily="Montserrat Thin" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,0" 
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Лоадер -->
        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
            </StackPanel>
        </Grid>

        <!-- Оверлей отклонения с причиной -->
        <Grid x:Name="RejectionOverlay" Background="#E61A1A2E" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Style="{StaticResource CardBorderStyle}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="30">
                    <TextBlock Text="ОТКЛОНЕНИЕ ЗАЯВКИ"
                               Foreground="#E81123"
                               FontFamily="Digital Pixel"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>
                    <TextBlock Text="Укажите причину отклонения (обязательно):"
                               Foreground="White"
                               FontFamily="Montserrat Thin"
                               FontSize="13"
                               Margin="0,0,0,12"/>
                    <Border Style="{StaticResource RegInputBorderStyle}" Height="110" Margin="0,0,0,20">
                        <TextBox x:Name="TbRejectionReason"
                                 Style="{StaticResource RegInnerInputStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalAlignment="Top"
                                 Padding="15"
                                 Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="ErrRejectionReason"
                               Text="Причина не может быть пустой"
                               Foreground="#E81123"
                               FontFamily="Montserrat Thin"
                               FontSize="12"
                               Visibility="Collapsed"
                               Margin="0,-10,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Отмена"
                                Style="{StaticResource OutlineButtonStyle}"
                                Width="130"
                                Height="42"
                                Margin="0,0,15,0"
                                Click="CancelRejection_Click"/>
                        <Button Content="Подтвердить отклонение"
                                Style="{StaticResource BaseModernButtonStyle}"
                                Background="#E81123"
                                Width="180"
                                Height="42"
                                Click="ConfirmRejection_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>