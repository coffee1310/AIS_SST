<Page x:Class="Diplom_Stud.Pages.Coordinator.EventRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d"
      d:DesignHeight="1000" d:DesignWidth="1111"
      Title="Event Requests"
      Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SoftActionBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <StackPanel>
            <TextBlock Text="Заявки на роли в мероприятии" 
                       Foreground="White" 
                       FontSize="20" 
                       FontFamily="Digital Pixel" 
                       Margin="0,0,0,20"/>

            <ItemsControl x:Name="RolesWithRequestsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{Binding RoleTitle}" 
                                               Foreground="#02B3BA" 
                                               FontSize="18" 
                                               FontFamily="Digital Pixel" 
                                               VerticalAlignment="Center"/>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" 
                                                  HorizontalAlignment="Right" 
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock Text="Свернуть/Развернуть" 
                                                           Foreground="#7A7886" 
                                                           FontFamily="Montserrat" 
                                                           FontSize="14" 
                                                           VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Applications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}" 
                                                        BorderBrush="#2A283C" 
                                                        BorderThickness="0,0,0,1" 
                                                        Margin="0,0,0,10" 
                                                        Padding="15,10,15,15" 
                                                        Cursor="Hand" 
                                                        MouseLeftButtonUp="RequestCard_Click" 
                                                        Tag="{Binding StudentId}">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" Width="46" Height="46" Margin="0,0,15,0">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" 
                                                                       Foreground="White" 
                                                                       FontFamily="Montserrat" 
                                                                       FontSize="16" 
                                                                       FontWeight="Medium" 
                                                                       Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding StudentEmail}" 
                                                                       Foreground="#02B3BA" 
                                                                       FontFamily="Montserrat Thin" 
                                                                       FontSize="12" 
                                                                       Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding Comment}" 
                                                                       Foreground="#7A7886" 
                                                                       FontFamily="Montserrat Thin" 
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding CommentVisibility}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                            <Button Content="Одобрить" 
                                                                    Style="{StaticResource SoftActionBtnStyle}" 
                                                                    Background="#2600C853"
                                                                    Foreground="#00C853" 
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="ApproveRequest_Click"/>

                                                            <Button Content="Отклонить" 
                                                                    Style="{StaticResource SoftActionBtnStyle}" 
                                                                    Background="#26E81123"
                                                                    Foreground="#E81123" 
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="RejectRequest_Click"/>

                                                            <Button Content="В резерв" 
                                                                    Style="{StaticResource SoftActionBtnStyle}" 
                                                                    Background="#26FFA500"
                                                                    Foreground="#FFA500" 
                                                                    Margin="0"
                                                                    Tag="{Binding ApplicationId}" 
                                                                    Click="ReserveRequest_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyAllText" 
                       Text="Заявки пока отсутствуют." 
                       Foreground="#7A7886" 
                       FontFamily="Montserrat Thin" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,0" 
                       Visibility="Collapsed"/>
        </StackPanel>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="RejectionOverlay" Background="#E61A1A2E" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="16" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="35">

                    <TextBlock Text="ОТКЛОНЕНИЕ ЗАЯВКИ"
                               Foreground="#E81123"
                               FontFamily="Digital Pixel"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Укажите причину отклонения (обязательно):"
                               Foreground="White"
                               FontFamily="Montserrat"
                               FontSize="13"
                               Margin="0,0,0,12"/>

                    <Border Background="#12101C" BorderBrush="#2A283C" BorderThickness="1.5" CornerRadius="8" Height="110" Margin="0,0,0,20">
                        <TextBox x:Name="TbRejectionReason"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Montserrat"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalAlignment="Top"
                                 Padding="15"
                                 CaretBrush="White"/>
                    </Border>

                    <TextBlock x:Name="ErrRejectionReason"
                               Text="Причина не может быть пустой"
                               Foreground="#E81123"
                               FontFamily="Montserrat Thin"
                               FontSize="12"
                               Visibility="Collapsed"
                               Margin="0,-10,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        
                        <Button Content="Отмена"
                                Width="130"
                                Height="44"
                                Margin="0,0,15,0"
                                Click="CancelRejection_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" BorderBrush="#2A283C" BorderThickness="1.5" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                            <Button.FontFamily>
                                <FontFamily>Montserrat</FontFamily>
                            </Button.FontFamily>
                            <Button.FontSize>14</Button.FontSize>
                        </Button>

                        <Button Content="Подтвердить отклонение"
                                Width="210"
                                Height="44"
                                Click="ConfirmRejection_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E81123" CornerRadius="22">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                            <Button.FontFamily>
                                <FontFamily>Montserrat</FontFamily>
                            </Button.FontFamily>
                            <Button.FontSize>14</Button.FontSize>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>