<Page x:Class="Diplom_Stud.Pages.Coordinator.EventRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <Grid>
        <StackPanel>
            <TextBlock Text="Управление заявками" Foreground="White" FontSize="20" FontFamily="Digital Pixel" Margin="0,0,0,20"/>

            <ItemsControl x:Name="RolesWithRequestsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{Binding RoleTitle}" Foreground="#A084FB" FontSize="18" FontFamily="Digital Pixel" Margin="0,0,0,15"/>
                                <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                                <ItemsControl ItemsSource="{Binding Applications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,15,0">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="15" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Comment}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" TextWrapping="Wrap" Visibility="{Binding CommentVisibility}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Принять" Style="{StaticResource ActionButtonStyle}" Background="#02B3BA" Foreground="Black" Margin="0,0,10,0" Tag="{Binding ApplicationId}" Click="ApproveRequest_Click"/>
                                                    <Button Content="Отклонить" Style="{StaticResource ActionButtonStyle}" Background="Transparent" Foreground="#E81123" BorderBrush="#E81123" BorderThickness="1" Tag="{Binding ApplicationId}" Click="RejectRequest_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Нет активных заявок" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" Visibility="{Binding EmptyTextVisibility}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>