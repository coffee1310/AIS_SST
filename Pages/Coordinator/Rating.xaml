<Page x:Class="Diplom_Stud.Pages.Coordinator.Rating"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1111"
      Title="Coordinator Rating"
      Loaded="Page_Loaded">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="950" Margin="40,50,40,50">

                <TextBlock Text="Общий рейтинг" FontSize="48" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Search bar -->
                <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="42" Margin="0,0,0,20">
                    <Grid Margin="12,0">
                        <TextBox x:Name="SearchBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="White" 
                                 FontFamily="Montserrat" 
                                 FontSize="14" 
                                 VerticalAlignment="Center" 
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" 
                                   Text="Поиск по фамилии" 
                                   Foreground="#7A7886" 
                                   FontFamily="Montserrat" 
                                   FontSize="14" 
                                   VerticalAlignment="Center" 
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Место" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="ФИО" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Роль" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Баллы" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" HorizontalAlignment="Center"/>
                </Grid>

                <ItemsControl x:Name="RatingItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="55" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Place}" Foreground="{Binding PlaceColor}" FontSize="22" FontFamily="Digital Pixel" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="White" FontSize="15" FontFamily="Montserrat" VerticalAlignment="Center" Margin="15,0,0,0" 
                                               Cursor="Hand" MouseLeftButtonUp="UserCard_Click" Tag="{Binding UserId}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="#7A7886" FontSize="14" FontFamily="Montserrat" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Points}" Foreground="#02B3BA" FontSize="18" FontFamily="Digital Pixel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Активисты не найдены." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="16" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>

                <Grid Margin="0,25,0,0">
                    <TextBlock x:Name="TotalActivistsText" Text="Всего активистов: 0" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="BtnPrevPage" Content="&lt;" Style="{StaticResource PaginationPageButtonStyle}" Click="PrevPage_Click" Margin="0,0,8,0" Width="36" Height="36"/>
                        <TextBlock x:Name="TxtPageInfo" Text="Страница 1 из 1" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>
                        <Button x:Name="BtnNextPage" Content="&gt;" Style="{StaticResource PaginationPageButtonStyle}" Click="NextPage_Click" Margin="8,0,0,0" Width="36" Height="36"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка рейтинга..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>