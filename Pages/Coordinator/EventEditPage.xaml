<Page x:Class="Diplom_Stud.Pages.Coordinator.EventEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.Coordinator"
      mc:Ignorable="d" 
      d:DesignHeight="1500" d:DesignWidth="950"
      Title="Event Edit"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=DatePicker}}"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontFamily" Value="Montserrat Thin"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent" Margin="{TemplateBinding Padding}"/>
                            <StackPanel x:Name="Watermark" Orientation="Horizontal" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=DatePicker}}" 
                                           Foreground="#7A7886" FontFamily="Montserrat Thin" 
                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=DatePicker}}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="White"/>

                            <Button x:Name="PART_Button" Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Path x:Name="CalIcon" Data="M19,3h-1V1h-2v2H8V1H6v2H5C3.89,3 3,3.9 3,5v14c0,1.1 0.89,2 2,2h14c1.1,0 2-0.9 2-2V5C21,3.9 20.1,3 19,3z M19,19H5V8h14V19z" 
                                                  Fill="#02B3BA" Stretch="Uniform" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CalIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="CalIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CalIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="CalIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="BgBorder" CornerRadius="12" Background="#12101C" BorderThickness="1.5" BorderBrush="#2A283C"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#7A7886" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#002A30"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#02B3BA"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#02B3BA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Digital Pixel"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,40,0,25"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" x:Name="MainRoot">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="800" Margin="40,10,40,80">

                <TextBlock Text="Основная информация" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,25"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource RegInputBorderStyle}" Margin="0,0,0,15">
                            <TextBox Text="{Binding EventTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" Tag="Название мероприятия"/>
                        </Border>
                        <Border Style="{StaticResource RegInputBorderStyle}" Height="200">
                            <TextBox Text="{Binding EventDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" Tag="Описание мероприятия" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" Padding="15"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource RegInputBorderStyle}" Margin="0,0,0,15">
                            <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Tag="Дата проведения" FontSize="14"/>
                        </Border>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource RegInputBorderStyle}">
                                <Grid>
                                    <Path Data="M11.99,2C6.47,2 2,6.48 2,12s4.47,10 9.99,10C17.52,22 22,17.52 22,12S17.52,2 11.99,2z M12,20c-4.42,0-8-3.58-8-8s3.58-8 8-8s8,3.58 8,8S16.42,20 12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23l-4.5-2.67V7z" Fill="#02B3BA" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                                    <TextBox Text="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" Tag="Время начала" MaxLength="5" PreviewTextInput="Time_PreviewTextInput" TextChanged="Time_TextChanged" Padding="40,0,15,0"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource RegInputBorderStyle}">
                                <Grid>
                                    <Path Data="M11.99,2C6.47,2 2,6.48 2,12s4.47,10 9.99,10C17.52,22 22,17.52 22,12S17.52,2 11.99,2z M12,20c-4.42,0-8-3.58-8-8s3.58-8 8-8s8,3.58 8,8S16.42,20 12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23l-4.5-2.67V7z" Fill="#7A7886" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                                    <TextBox Text="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" Tag="Время конца" MaxLength="5" PreviewTextInput="Time_PreviewTextInput" TextChanged="Time_TextChanged" Padding="40,0,15,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource RegInputBorderStyle}">
                            <Grid>
                                <Path Data="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7-7.75 7-13C19,5.13 15.87,2 12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5s2.5,1.12 2.5,2.5S13.38,11.5 12,11.5z" Fill="#02B3BA" Stretch="Uniform" Width="14" Height="18" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                                <TextBox Text="{Binding Venue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RegInnerInputStyle}" Tag="Место проведения" Padding="40,0,15,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Медиа и доступ" Style="{StaticResource SubtitleStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Height="110" Cursor="Hand" MouseLeftButtonUp="UploadImage_Click">
                        <Rectangle Stroke="#2A283C" StrokeThickness="1.5" StrokeDashArray="4 4" RadiusX="8" RadiusY="8" Fill="#1C1B29"/>
                        <StackPanel x:Name="UploadPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M19,4h-3.17L14,2H10L8.17,4H5C3.9,4 3,4.9 3,6v12c0,1.1 0.9,2 2,2h14c1.1,0 2-0.9 2-2V6C21,4.9 20.1,4 19,4z M12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5s5,2.24 5,5S14.76,17 12,17z M12,9c-1.65,0-3,1.35-3,3s1.35,3 3,3s3-1.35 3-3S13.65,9 12,9z" Fill="#7A7886" Stretch="Uniform" Width="24" Height="20" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Изменить фото" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border CornerRadius="8" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush x:Name="EditEventImage" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource RegInputBorderStyle}" Height="Auto" Padding="20,15">
                        <StackPanel VerticalAlignment="Center">

                            <Grid Margin="0,0,0,15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Публичное событие" Foreground="White" FontFamily="Montserrat" FontSize="14"/>
                                    <TextBlock Text="Доступно всем зарегистрировавшимся" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsPublic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Свободное мероприятие" Foreground="White" FontFamily="Montserrat" FontSize="14"/>
                                    <TextBlock Text="Вход без предварительного одобрения заявок" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsFree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#2A283C" Margin="0,0,0,15"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Черновик" Foreground="White" FontFamily="Montserrat" FontSize="14"/>
                                    <TextBlock Text="Сохранить для дальнейшего редактирования" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Доп. Организаторы" Style="{StaticResource SubtitleStyle}"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource RegInputBorderStyle}" Height="45">
                        <Grid>
                            <ComboBox x:Name="CbUsers" 
                                      IsEditable="True" 
                                      StaysOpenOnEdit="True"
                                      Cursor="IBeam"
                                      Style="{StaticResource ModernComboBoxStyle}" 
                                      Uid="Поиск пользователя (ФИО)..."/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Content="Добавить" Style="{StaticResource OutlineButtonStyle}" Foreground="#02B3BA" BorderBrush="#02B3BA" Padding="0" Click="AddOrganizer_Click"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding SelectedOrganizers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButtonStyle}" Foreground="#E81123" FontSize="14" Click="RemoveOrganizer_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,25">
                    <TextBlock Text="Роли и задачи" Foreground="White" FontFamily="Digital Pixel" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#615292" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RolesCountText}" Foreground="White" FontSize="10" FontFamily="Montserrat"/>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="RolesItemsControl" ItemsSource="{Binding Roles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,15">
                                <Border x:Name="RoleBorder" Style="{StaticResource RegInputBorderStyle}" Height="Auto" Padding="25">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,0" Height="45">
                                            <TextBlock x:Name="CollapsedTitle" 
                                                       Text="{Binding SelectedRole.title, TargetNullValue='Выберите роль...', FallbackValue='Выберите роль...'}" 
                                                       Foreground="White" FontFamily="Digital Pixel" FontSize="14" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Visible"/>

                                            <Border x:Name="ExpandedComboBox" Style="{StaticResource RegInputBorderStyle}" Width="300" HorizontalAlignment="Left" Height="45" Visibility="Collapsed">
                                                <Grid>
                                                    <ComboBox ItemsSource="{Binding AvailableRoles}" 
                                                              SelectedItem="{Binding SelectedRole, Mode=TwoWay}" 
                                                              Style="{StaticResource ModernComboBoxStyle}"/>

                                                    <TextBlock Text="Выберите роль..." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedRole}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid Background="Transparent" Width="30" Height="30">
                                                            <Path x:Name="Arrow" Data="M 2,4 L 8,10 L 14,4" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Arrow" Property="Data" Value="M 2,10 L 8,4 L 14,10"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>

                                        <Grid x:Name="DetailsGrid" Visibility="Collapsed" Margin="0,20,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Height="160" Margin="0,0,0,15">
                                                <TextBox Text="{Binding Tasks, Mode=TwoWay}" Style="{StaticResource RegInnerInputStyle}" Tag="Задачи" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" Padding="15"/>
                                            </Border>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Количество людей" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="5,0,0,5"/>
                                                        <Border Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                            <TextBox Text="{Binding PeopleCount, Mode=TwoWay}" Style="{StaticResource RegInnerInputStyle}" TextAlignment="Center" Padding="0" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Количество баллов" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="5,0,0,5"/>
                                                        <Border Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                            <TextBox Text="{Binding Points, Mode=TwoWay}" Style="{StaticResource RegInnerInputStyle}" TextAlignment="Center" Padding="0" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel>
                                                    <TextBlock Text="Количество людей в резерв" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="5,0,0,5"/>
                                                    <Border Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                        <TextBox Text="{Binding ReserveCount, Mode=TwoWay}" Style="{StaticResource RegInnerInputStyle}" TextAlignment="Center" Padding="0" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                    <DatePicker SelectedDate="{Binding DeadlineDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Tag="Дедлайн (ГГГГ-ММ-ДД)" FontSize="14"/>
                                                </Border>

                                                <Border Grid.Column="2" Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                    <Grid>
                                                        <Path Data="M11.99,2C6.47,2 2,6.48 2,12s4.47,10 9.99,10C17.52,22 22,17.52 22,12S17.52,2 11.99,2z M12,20c-4.42,0-8-3.58-8-8s3.58-8 8-8s8,3.58 8,8S16.42,20 12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23l-4.5-2.67V7z" Fill="#7A7886" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                        <TextBox Text="{Binding DeadlineTime, Mode=TwoWay}" Style="{StaticResource RegInnerInputStyle}" Tag="Время" MaxLength="5" PreviewTextInput="Time_PreviewTextInput" TextChanged="Time_TextChanged" FontSize="14" Padding="30,0,10,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom">
                                                <TextBlock Text="Ответственный сектор" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10" Margin="5,0,0,5"/>
                                                <Border Style="{StaticResource RegInputBorderStyle}" Height="40">
                                                    <ComboBox ItemsSource="{Binding AvailableSectors}" SelectedItem="{Binding SelectedSector, Mode=TwoWay}" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button DataContext="{Binding}" Click="RemoveRole_Click" Width="20" Height="20" Background="#02B3BA" Foreground="Black" Content="✕" FontSize="12" FontFamily="Montserrat" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="DetailsGrid" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="RoleBorder" Property="Background" Value="#3A2D6E"/>
                                    <Setter TargetName="RoleBorder" Property="BorderBrush" Value="#574596"/>
                                    <Setter TargetName="ExpandedComboBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CollapsedTitle" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Height="50" Cursor="Hand" Margin="0,0,0,40" MouseLeftButtonUp="AddRole_Click">
                    <Rectangle Stroke="#2A283C" StrokeThickness="1.5" StrokeDashArray="4 4" RadiusX="8" RadiusY="8" Fill="#1C1B29"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="+" Foreground="#7A7886" FontFamily="Montserrat" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Добавить роль" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="btnSave" Content="Сохранить изменения" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Padding="40,15" FontSize="14" Click="SaveFinalEvent_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0" Margin="0,0,0,15"/>
                <TextBlock Text="Загрузка данных..." Foreground="White" FontFamily="Digital Pixel" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>