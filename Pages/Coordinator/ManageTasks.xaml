<Page x:Class="Diplom_Stud.Pages.Coordinator.ManageTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление задачами"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="SoftActionBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="800" Margin="40,50,40,80">

                <TextBlock Text="Управление задачами" FontSize="36" FontFamily="Digital Pixel" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Border Style="{StaticResource CardBorderStyle}" Padding="25" Margin="0,0,0,40">
                    <StackPanel>
                        <TextBlock Text="Создать новую задачу" Foreground="#02B3BA" FontFamily="Digital Pixel" FontSize="20" Margin="0,0,0,20"/>
                        <Border Style="{StaticResource RegInputBorderStyle}" Margin="0,0,0,15">
                            <TextBox x:Name="TbTitle" Style="{StaticResource RegInnerInputStyle}" Tag="Название задачи"/>
                        </Border>
                        <Border Style="{StaticResource RegInputBorderStyle}" Height="120" Margin="0,0,0,15">
                            <TextBox x:Name="TbDescription" Style="{StaticResource RegInnerInputStyle}" Tag="Описание задачи" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" Padding="15"/>
                        </Border>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource RegInputBorderStyle}">
                                <DatePicker x:Name="DpDeadline" SelectedDateFormat="Short" Tag="Дедлайн" FontSize="14" Padding="15,0"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource RegInputBorderStyle}">
                                <TextBox x:Name="TbMaxPeople" Style="{StaticResource RegInnerInputStyle}" Tag="Кол-во человек" PreviewTextInput="Numeric_Preview"/>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource RegInputBorderStyle}">
                                <TextBox x:Name="TbPoints" Style="{StaticResource RegInnerInputStyle}" Tag="Баллы за выполнение" PreviewTextInput="Numeric_Preview"/>
                            </Border>
                        </Grid>
                        <Button Content="Создать задачу" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Click="CreateTask_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Новые заявки на ваши задачи" Foreground="White" FontFamily="Digital Pixel" FontSize="20" Margin="0,0,0,20"/>
                <ItemsControl x:Name="RequestsList" Margin="0,0,0,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1B29" BorderBrush="#2A283C" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" Foreground="White" FontFamily="Montserrat" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding taskTitle}" Foreground="#02B3BA" FontFamily="Montserrat Thin" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Одобрить" Style="{StaticResource SoftActionBtnStyle}" Background="#2600C853" Foreground="#00C853" Tag="{Binding id}" Click="ApproveReq_Click"/>
                                        <Button Content="Отклонить" Style="{StaticResource SoftActionBtnStyle}" Background="#26E81123" Foreground="#E81123" Tag="{Binding id}" Click="RejectReq_Click" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyReqText" Text="Заявок на рассмотрении пока нет." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed"/>

                <TextBlock Text="Ваши созданные задачи (активные)" Foreground="White" FontFamily="Digital Pixel" FontSize="20" Margin="0,0,0,20"/>
                <ItemsControl x:Name="MyTasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding title}" Foreground="White" FontFamily="Digital Pixel" FontSize="18" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding description}" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Дедлайн: " Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10"/>
                                            <TextBlock Text="{Binding DeadlineDisplay}" Foreground="#02B3BA" FontFamily="Montserrat" FontSize="10" Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding assignedUsersCount}" Foreground="White" FontFamily="Montserrat" FontSize="10"/>
                                            <TextBlock Text=" чел. в работе" Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Завершить задачу" Style="{StaticResource SoftActionBtnStyle}" Background="#2600C853" Foreground="#00C853" Tag="{Binding id}" Click="CompleteTask_Click" Margin="0,0,0,10"/>
                                        <Button Content="Удалить" Style="{StaticResource SoftActionBtnStyle}" Background="#26E81123" Foreground="#E81123" Tag="{Binding id}" Click="DeleteTask_Click" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyTasksText" Text="У вас нет активных созданных задач." Foreground="#7A7886" FontFamily="Montserrat Thin" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#E61A1A2E" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="#02B3BA" Background="#2A283C" BorderThickness="0"/>
        </Grid>
    </Grid>
</Page>