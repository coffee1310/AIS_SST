<Page x:Class="Diplom_Stud.Pages.General.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Stud.Pages.General"
      mc:Ignorable="d" 
      d:DesignHeight="1024"
      Title="Auth" Width="1538"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1B29"/>
            <Setter Property="BorderBrush" Value="#2A283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="51"/>
            <Setter Property="Width" Value="336"/>
        </Style>

        <Style x:Key="InnerInputStyle" TargetType="Control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#615292"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#7363A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для индикаторов слайдов -->
        <Style x:Key="SlideIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#7A7886"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#0D0914" Offset="0"/>
                <GradientStop Color="#1A1525" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая часть (без изменений) -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50,0">
            <Image Source="/Resources/logo.png" Width="139" Height="87" Margin="0,0,0,20" Stretch="Uniform"/>

            <TextBlock Text="Студенческий совет КИПФИН" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Digital Pixel" Margin="0,0,0,10"/>

            <TextBlock Foreground="#FFFFFF" FontSize="27" 
                       HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Montserrat Thin" Margin="0,0,0,40">
                <Run Text="Управляй своей"/><LineBreak/><Run Text="студенческой жизнью"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Мероприятия" Foreground="#02B3BA" FontSize="18"/>

                <TextBlock Text="·" Foreground="#FFFFFF" FontSize="18" Margin="10,0"/>

                <TextBlock Text="Сектора" Foreground="#02B3BA" FontSize="18"/>

                <TextBlock Text="·" Foreground="#FFFFFF" FontSize="18" Margin="10,0"/>

                <TextBlock Text="Рейтинг" Foreground="#A084FB" FontSize="18"/>

                <TextBlock Text="·" Foreground="#FFFFFF" FontSize="18" Margin="10,0"/>

                <TextBlock Text="Проекты" Foreground="#A084FB" FontSize="18"/>
            </StackPanel>
        </StackPanel>

        <!-- Правая часть с перелистывающимися изображениями -->
        <Border Grid.Column="1" Background="#12101C" Width="613" Height="722" CornerRadius="23" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Opacity="0.5" ShadowDepth="10" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="322"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Контейнер для перелистывания изображений -->
                <Border Grid.Row="0" CornerRadius="23" ClipToBounds="True">
                    <Grid x:Name="SlidesContainer">
                        <Image x:Name="SlideImage1" Source="/Resources/auth.png" Stretch="UniformToFill" Opacity="1"/>
                        <Image x:Name="SlideImage2" Source="/Resources/auth2.jpg" Stretch="UniformToFill" Opacity="0"/>
                        <Image x:Name="SlideImage3" Source="/Resources/auth3.png" Stretch="UniformToFill" Opacity="0"/>
                    </Grid>
                </Border>

                <!-- Индикаторы слайдов -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15">
                    <Ellipse x:Name="Indicator1" Style="{StaticResource SlideIndicatorStyle}" Fill="#615292"/>
                    <Ellipse x:Name="Indicator2" Style="{StaticResource SlideIndicatorStyle}" Fill="#7A7886"/>
                    <Ellipse x:Name="Indicator3" Style="{StaticResource SlideIndicatorStyle}" Fill="#7A7886"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Width="336" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Margin="0,0,0,15">
                        <Border Style="{StaticResource InputBorderStyle}"/>
                        <TextBox x:Name="tbLogin" Style="{StaticResource InnerInputStyle}"/>
                        <TextBlock Text="Логин" IsHitTestVisible="False" Foreground="#7A7886" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14" FontFamily="Montserrat Thin">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbLogin}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Border Style="{StaticResource InputBorderStyle}"/>
                        <PasswordBox x:Name="pbPassword" Style="{StaticResource InnerInputStyle}"/>
                        <TextBlock Text="Пароль" IsHitTestVisible="False" Foreground="#7A7886" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14" FontFamily="Montserrat Thin">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Password, ElementName=pbPassword}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Забыли пароль?" Foreground="#7A7886" FontSize="12" 
                               HorizontalAlignment="Left" Margin="15,0,0,30" Cursor="Hand" FontFamily="Montserrat Thin"/>

                    <Button Content="Войти" Style="{StaticResource ModernButtonStyle}" 
                            Width="283" Height="50" Margin="0,0,0,25" 
                            FontFamily="Digital Pixel" FontSize="9" Click="Button_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Нет аккаунта? " Foreground="#7A7886" FontSize="14" FontFamily="Montserrat Thin"/>
                        <TextBlock Text="Зарегистрироваться" Foreground="#02B3BA" Cursor="Hand" FontSize="14" FontFamily="Montserrat Thin"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>